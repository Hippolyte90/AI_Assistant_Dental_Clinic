# Local configuration. No API keys: everything runs on this machine.
OLLAMA_HOST=http://127.0.0.1:11434
LLM_MODEL=qwen3:4b
LLM_THINK=false
LLM_NUM_CTX=8192
LLM_TEMPERATURE=0
LLM_TIMEOUT_S=300
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
STORAGE_DIR=storage
CLINIC_NAME=Dental Clinic
CLINIC_ADDRESS=
DENTIST_NAME=

# User accounts. Keep this on for the public link.
AUTH_REQUIRED=true
MAX_ACCOUNTS=100
